@inject IConfiguration Configuration
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1B2C59" />
    <title>Lupa Kata Sandi — PT Pos Indonesia</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/auth.css?v=@DateTime.UtcNow.Ticks" />

    <style>

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100vh;
            max-height: 100vh;
            width: 100vw;
            margin: 0;
            padding: 0;
            overflow: hidden !important;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #0f172a;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Bright PT Pos Signature Canvas (Strictly Blue & White, Zero Orange) ── */
        body.auth-page-pos {
            height: 100vh;
            max-height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            position: relative;
            overflow: hidden !important;
            background-color: #f8fafc;
            background-image: none;
        }

        /* Subtle Geometric Dot Grid */
        body.auth-page-pos::before {
            display: none;
        }

        /* Centered Shell */
        .auth-card-shell {
            width: 100%;
            max-width: 380px;
            margin: auto;
            position: relative;
            z-index: 10;
        }

        /* Crisp Elevated White Card */
        .auth-pure-card {
            background-color: #FFFFFF !important;
            background: #FFFFFF !important;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 32px 30px 24px;
            box-shadow: 
                0 4px 6px -1px rgba(15, 23, 42, 0.04),
                0 20px 35px -10px rgba(15, 23, 42, 0.08);
            position: relative;
        }

        /* Header */
        .auth-head-box {
            text-align: center;
            margin-bottom: 22px;
        }

        .auth-main-logo {
            height: 54px;
            width: auto;
            max-width: 180px;
            object-fit: contain;
            margin-bottom: 12px;
            display: inline-block;
            filter: none !important;
            box-shadow: none !important;
        }

        .auth-main-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.3px;
            line-height: 1.25;
            margin: 0;
        }

        /* Alert Notification */
        .auth-notice-alert {
            display: none;
            padding: 9px 12px;
            border-radius: 8px;
            font-size: 0.78rem;
            line-height: 1.35;
            margin-bottom: 14px;
            align-items: center;
            gap: 8px;
        }

        .auth-notice-alert.alert-danger {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .auth-notice-alert.alert-success {
            background-color: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        .auth-notice-alert i {
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        /* Form Fields: Consistent 6px Label-to-Input Spacing */
        .auth-input-group {
            margin-bottom: 16px;
            text-align: left;
        }

        .auth-label-row {
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .auth-field-label {
            margin: 0;
            padding: 0;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #1e293b;
            line-height: 20px;
            letter-spacing: -0.1px;
            display: inline-block;
        }

        .auth-forgot-link {
            font-size: 0.78rem;
            color: #1B2C59;
            text-decoration: none;
            font-weight: 600;
            line-height: 20px;
            transition: color 0.15s ease;
        }

        .auth-forgot-link:hover {
            color: #2b4991;
            text-decoration: underline;
        }

        .auth-control-wrap {
            position: relative;
            height: 42px;
            display: flex;
            align-items: center;
        }

        .auth-control-wrap .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
            pointer-events: none;
            transition: color 0.15s ease;
        }

        .auth-text-input {
            width: 100%;
            height: 42px;
            padding: 0 14px 0 40px;
            font-size: 0.875rem;
            font-family: inherit;
            color: #0f172a;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-text-input:focus {
            border-color: #1B2C59;
            box-shadow: 0 0 0 3px rgba(27, 44, 89, 0.12);
        }

        .auth-control-wrap:focus-within .field-icon {
            color: #1B2C59;
        }

        .auth-text-input::placeholder {
            color: #94a3b8;
            font-size: 0.82rem;
        }

        .btn-eye-action {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s ease;
        }

        .btn-eye-action:hover {
            color: #334155;
        }

        /* Checkbox */
        .auth-remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            font-size: 0.8125rem;
            color: #475569;
            cursor: pointer;
            user-select: none;
        }

        .auth-remember-row input[type="checkbox"] {
            accent-color: #1B2C59;
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

        /* Submit Button */
        .btn-auth-submit {
            width: 100%;
            height: 42px;
            background-color: #1B2C59;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(27, 44, 89, 0.20);
            transition: background-color 0.15s ease, transform 0.1s ease;
        }

        .btn-auth-submit:hover {
            background-color: #142247;
        }

        .btn-auth-submit:active {
            transform: scale(0.99);
        }

        .btn-auth-submit:disabled {
            background-color: #94a3b8;
            cursor: not-allowed;
            transform: none;
        }

        /* Footer */
        .auth-bottom-footer {
            margin-top: 18px;
            text-align: center;
            font-size: 0.72rem;
            color: #94a3b8;
        }

        /* Back Link for secondary pages */
        .auth-return-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            margin-top: 14px;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #1B2C59;
            text-decoration: none;
            transition: color 0.15s ease;
        }

        .auth-return-link:hover {
            color: #2b4991;
            text-decoration: underline;
        }

        /* OTP Row */
        .auth-otp-row {
            display: flex;
            justify-content: space-between;
            gap: 6px;
            margin: 10px 0 16px;
        }

        .auth-otp-cell {
            width: 100%;
            height: 44px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #ffffff;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 700;
            color: #0f172a;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .auth-otp-cell:focus {
            border-color: #1B2C59;
            box-shadow: 0 0 0 3px rgba(27, 44, 89, 0.12);
        }

        /* Spinner animation */
        .spin-loader {
            animation: spinAnim 0.85s infinite linear;
        }

        @@keyframes spinAnim {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
</head>
<body class="auth-page-pos">

    <main class="auth-card-shell">
        <section class="auth-pure-card">

            <div class="auth-head-box">
                <img src="~/custom/content/img/logo-pos.png" alt="PT Pos Indonesia" class="auth-main-logo" />
                <h1 class="auth-main-title">Lupa Kata Sandi</h1>
            </div>

            <div id="message" class="auth-notice-alert" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <span id="alertText"></span>
            </div>

            <form id="forgotPasswordForm">
                <div class="auth-input-group">
                    <div class="auth-label-row">
                        <label class="auth-field-label" for="email">Alamat Email Terdaftar</label>
                    </div>
                    <div class="auth-control-wrap">
                        <i class="bi bi-envelope field-icon"></i>
                        <input type="email" 
                               id="email" 
                               class="auth-text-input" 
                               placeholder="nama@posindonesia.co.id" 
                               required 
                               autocomplete="email" 
                               autofocus>
                    </div>
                </div>

                <button type="submit" class="btn-auth-submit" id="btnSubmit">
                    <span>Kirim Kode Verifikasi</span>
                    <i class="bi bi-send"></i>
                </button>
            </form>

            <a href="/Auth/Login" class="auth-return-link">
                <i class="bi bi-arrow-left"></i>
                <span>Kembali ke Halaman Masuk</span>
            </a>

            <footer class="auth-bottom-footer">
                &copy; 2026 PT Pos Indonesia (Persero) - KCP 44188 Malangbong Garut
            </footer>

        </section>
    </main>

    <script>
        let API_BASE_URL = "@Configuration["ApiSettings:BaseUrl"]";
        if (API_BASE_URL.includes("localhost:21001") || API_BASE_URL.includes("127.0.0.1:21001")) {
            API_BASE_URL = window.location.protocol + "//" + window.location.hostname + ":21001";
        }

        $(function () {
            const $form = $("#forgotPasswordForm");
            const $btn = $("#btnSubmit");
            const $msg = $("#message");
            const $alertText = $("#alertText");

            function showAlert(type, text) {
                $msg.removeClass("alert-danger alert-success").addClass("alert-" + type);
                $alertText.text(text);
                $msg.css("display", "flex");
            }

            $form.on("submit", function (e) {
                e.preventDefault();
                $msg.hide();

                const email = $("#email").val().trim();
                if (!email) {
                    showAlert("danger", "Silakan masukkan alamat email.");
                    return;
                }

                $btn.prop("disabled", true).find("span").text("Mengirim kode...");

                $.ajax({
                    url: API_BASE_URL + "/api/auth/forgot-password",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ email: email }),
                    success: function (res) {
                        showAlert("success", res.message || "Kode OTP telah dikirim.");
                        sessionStorage.setItem("resetEmail", email);
                        setTimeout(function () {
                            window.location.href = "/Auth/VerifikasiOTP";
                        }, 1200);
                    },
                    error: function (xhr) {
                        const err = xhr.responseJSON ? xhr.responseJSON.message : "Gagal mengirim kode verifikasi.";
                        showAlert("danger", err);
                        $btn.prop("disabled", false).find("span").text("Kirim Kode Verifikasi");
                    }
                });
            });
        });
    </script>
</body>
</html>