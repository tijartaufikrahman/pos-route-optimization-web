@{
    ViewData["Title"] = "Master Role";
}

<main>
    <div class="breadcrumb-bar">
        <span class="current">Master Role</span>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title-section">Daftar Role</h5>
            <button class="btn btn-pos d-inline-flex align-items-center gap-2" onclick="openModalAdd()">
                <i class="bi bi-plus-lg"></i> Tambah Role
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tableRole" class="table table-bordered table-pos w-100">
                    <thead>
                        <tr>
                            <th style="width:55px;">No</th>
                            <th>Nama Role / Jabatan</th>
                            <th style="width:160px;">Jumlah Pengguna</th>
                            <th style="width:100px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<!-- MODAL -->
<div class="modal fade" id="modalRole" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title header-title" id="modalTitle">Tambah Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formRole">
                <div class="modal-body">
                    <input type="hidden" id="roleId">
                    <div class="mb-1">
                        <label class="label-pos">Nama Role</label>
                        <input type="text" class="form-control form-control-pos" id="namaRole" placeholder="Contoh: Admin" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline px-4" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-pos px-4">Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const API_URL = API_BASE_URL+"/api/roles";
    let table;

    $(document).ready(function () {
        table = $('#tableRole').DataTable({
            pageLength: 10,
            dom: '<"p-3 border-bottom d-flex justify-content-between align-items-center"lf>t<"p-3 d-flex justify-content-between align-items-center"ip>',
            language: {
                search: "Cari:",
                lengthMenu: "Tampilkan _MENU_",
                paginate: { previous: "‹", next: "›" }
            },
            columnDefs: [
                { targets: [0, 2, 3], className: "text-center" },
                { targets: 3, orderable: false }
            ]
        });

        loadData();

        $('#formRole').on('submit', function (e) {
            e.preventDefault();
            saveRole();
        });
    });

    function loadData() {
        $.get(API_URL, function (data) {
            table.clear();
            data.forEach((r, i) => {
                table.row.add([
                    i + 1,
                    `<span class="fw-medium" style="color: var(--pos-text);">${r.namaRole}</span>`,
                    `<span class="badge badge-blue">${r.jumlahUser || 0} User</span>`,
                    `<div class="d-flex justify-content-center gap-1">
                        <button class="btn-action btn-edit" onclick="openModalEdit(${r.id}, '${r.namaRole}')" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn-action btn-delete" onclick="deleteRole(${r.id})" title="Hapus">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>`
                ]);
            });
            table.draw();
        }).fail(function () {
            console.error("Gagal menghubungi API.");
        });
    }

    function openModalAdd() {
        $('#roleId').val('');
        $('#namaRole').val('');
        $('#modalTitle').text('Tambah Role');
        $('#modalRole').modal('show');
    }

    function openModalEdit(id, nama) {
        $('#roleId').val(id);
        $('#namaRole').val(nama);
        $('#modalTitle').text('Edit Role');
        $('#modalRole').modal('show');
    }

    function saveRole() {
        const id = $('#roleId').val();
        const payload = { id: id ? parseInt(id) : 0, namaRole: $('#namaRole').val().trim() };
        const isEdit = id !== "";

        $.ajax({
            url: isEdit ? `${API_URL}/${id}` : API_URL,
            type: isEdit ? 'PUT' : 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                $('#modalRole').modal('hide');
                loadData();
                alert("Berhasil: " + (res.message || "Data tersimpan"));
            },
            error: function (xhr) {
                alert("Error: " + (xhr.responseJSON?.message || "Terjadi kesalahan sistem"));
            }
        });
    }

    function deleteRole(id) {
        if (confirm("Apakah Anda yakin ingin menghapus role ini?")) {
            $.ajax({
                url: `${API_URL}/${id}`,
                type: 'DELETE',
                success: function (res) { loadData(); alert(res.message); },
                error: function (xhr) {
                    alert(xhr.responseJSON?.message || "Gagal menghapus data");
                }
            });
        }
    }
</script>
}
