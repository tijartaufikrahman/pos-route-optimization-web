@{
    ViewData["Title"] = "Pengaturan";
}

<main>
    <div class="breadcrumb-bar">
        <span class="current">Pengaturan</span>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title-section">Hapus Data</h5>
                </div>
                <div class="card-body">
                    <p class="mb-4" style="font-size:0.8rem; color: var(--pos-text-muted);">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                        Hati-hati — data yang dihapus tidak dapat dikembalikan.
                    </p>

                    <div class="d-flex flex-column gap-3">
                        <!-- Hapus Kiriman -->
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: var(--pos-red-bg); border: 1px solid rgba(239,68,68,0.2);">
                            <div>
                                <div style="font-size:0.82rem; font-weight:600; color: var(--pos-text);">Hapus Semua Data Kiriman</div>
                                <div style="font-size:0.73rem; color: var(--pos-text-muted); margin-top:2px;">Menghapus seluruh data kiriman dari sistem</div>
                            </div>
                            <button class="btn btn-danger-modern px-4 d-flex align-items-center gap-2" id="btnHapusKiriman">
                                <i class="bi bi-trash-fill"></i> Hapus Kiriman
                            </button>
                        </div>

                        <!-- Hapus POD -->
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: var(--pos-yellow-bg); border: 1px solid rgba(245,158,11,0.2);">
                            <div>
                                <div style="font-size:0.82rem; font-weight:600; color: var(--pos-text);">Hapus Semua Data POD</div>
                                <div style="font-size:0.73rem; color: var(--pos-text-muted); margin-top:2px;">Menghapus seluruh data proof of delivery dari sistem</div>
                            </div>
                            <button class="btn btn-warning-modern px-4 d-flex align-items-center gap-2" id="btnHapusPOD">
                                <i class="bi bi-trash-fill"></i> Hapus POD
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    $(document).ready(function () {
        // ── HAPUS KIRIMAN ──
        $('#btnHapusKiriman').click(function () {
            if (!confirm('Yakin ingin menghapus SEMUA data kiriman? Data yang sudah dihapus tidak dapat dikembalikan!')) return;

            const btn = $(this);
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Menghapus...');

            $.ajax({
                url: API_BASE_URL + '/api/paket/delete-all',
                type: 'DELETE',
                success: function (res) {
                    btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Hapus Kiriman');
                    alert('Semua data kiriman berhasil dihapus.');
                },
                error: function (err) {
                    btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Hapus Kiriman');
                    alert('Gagal menghapus data kiriman. ' + (err.responseJSON?.message || err.statusText));
                }
            });
        });

        // ── HAPUS POD ──
        $('#btnHapusPOD').click(function () {
            if (!confirm('Yakin ingin menghapus SEMUA data POD? Data yang sudah dihapus tidak dapat dikembalikan!')) return;

            const btn = $(this);
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Menghapus...');

            $.ajax({
                url: API_BASE_URL + '/api/pod/hapus-all',
                type: 'DELETE',
                success: function (res) {
                    btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Hapus POD');
                    alert('Semua data POD berhasil dihapus.');
                },
                error: function (err) {
                    btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Hapus POD');
                    alert('Gagal menghapus data POD. ' + (err.responseJSON?.message || err.statusText));
                }
            });
        });
    });
</script>
