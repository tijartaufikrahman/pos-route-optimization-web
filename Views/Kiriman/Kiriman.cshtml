@{
    ViewData["Title"] = "Data Kiriman";
}

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBqkyOYHvgAZt-mpcn3V_14KoSJJ3Hr4MM&libraries=places" async defer></script>

<style>
    .status-badge {
        padding: 5px 10px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 500;
        display: inline-block;
    }
    .status-manifested {
        color: var(--pos-blue);
        background: rgba(27, 44, 89, 0.08);
        border: 1px solid rgba(27, 44, 89, 0.15);
    }
    .status-delivery {
        color: #B45309;
        background: #FEF3C7;
        border: 1px solid #FDE68A;
    }
    .status-completed {
        color: #15803D;
        background: #DCFCE7;
        border: 1px solid #BBF7D0;
    }
    .status-returned {
        color: #B91C1C;
        background: #FEE2E2;
        border: 1px solid #FECACA;
    }
    .filter-action-spacer {
        display: block;
    }
    @@media (max-width: 991.98px) {
        .filter-action-spacer {
            display: none;
        }
    }
    /* Table Card Two-Tier Header & Controls */
    .table-card-topbar {
        padding: 1.15rem 1.75rem;
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-main-title {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.01em;
    }

    .table-controls-bar {
        padding: 0.85rem 1.75rem;
        background: #fafbfc;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .table-controls-left {
        display: flex;
        align-items: center;
    }

    .table-controls-right {
        display: flex;
        align-items: center;
    }

    #tableLengthContainer .dt-length,
    #tableLengthContainer .dataTables_length,
    #tableSearchContainer .dt-search,
    #tableSearchContainer .dataTables_filter {
        margin: 0 !important;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    #tableLengthContainer label,
    #tableSearchContainer label {
        margin: 0 !important;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #475569;
        white-space: nowrap;
    }

    #tableLengthContainer select,
    #tableLengthContainer .form-select {
        height: 34px !important;
        padding: 0 28px 0 10px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        font-size: 0.8rem !important;
        font-weight: 500;
        color: #1e293b !important;
        background-color: #ffffff !important;
        cursor: pointer;
        display: inline-block !important;
        width: auto !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    #tableLengthContainer select:focus {
        border-color: #1B2C59 !important;
        box-shadow: 0 0 0 3px rgba(27, 44, 89, 0.08) !important;
        outline: none;
    }

    #tableSearchContainer input,
    #tableSearchContainer .form-control {
        height: 34px !important;
        padding: 0 11px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        font-size: 0.8rem !important;
        color: #1e293b !important;
        background-color: #ffffff !important;
        width: 190px !important;
        outline: none;
        display: inline-block !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        transition: border-color 0.15s ease, box-shadow 0.15s ease, width 0.2s ease;
    }

    #tableSearchContainer input:focus {
        border-color: #1B2C59 !important;
        box-shadow: 0 0 0 3px rgba(27, 44, 89, 0.08) !important;
        width: 220px !important;
    }

    .btn-import-action {
        height: 34px;
        padding: 0 13px;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 6px;
        background-color: #1B2C59;
        color: #ffffff;
        border: 1px solid transparent;
        box-shadow: 0 1px 2px rgba(27, 44, 89, 0.12);
        transition: all 0.2s ease;
    }

    .btn-import-action:hover {
        background-color: #142245;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 5px -1px rgba(27, 44, 89, 0.2);
    }

    .filter-inputs-wrap {
        display: flex;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
    }

    .filter-item-date {
        width: 175px;
    }

    .filter-item-select {
        width: 175px;
    }

    .btn-filter-compact {
        height: 34px !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        border-radius: 6px !important;
        padding: 0 16px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        width: auto !important;
    }

    @@media (max-width: 576px) {
        .filter-item-date,
        .filter-item-select {
            width: 100% !important;
        }
        .btn-filter-compact {
            width: 100% !important;
        }
    }

    /* Enhanced Table Padding for Kiriman */
    #paketTable thead th {
        padding: 1.15rem 1.35rem !important;
        font-size: 0.76rem !important;
        letter-spacing: 0.04em !important;
        white-space: nowrap !important;
    }

    #paketTable tbody td {
        padding: 1.15rem 1.35rem !important;
        font-size: 0.84rem !important;
        vertical-align: middle !important;
    }

    #paketTable thead th:first-child,
    #paketTable tbody td:first-child {
        padding-left: 1.75rem !important;
    }

    #paketTable thead th:last-child,
    #paketTable tbody td:last-child {
        padding-right: 1.75rem !important;
    }

    .dash-table-wrapper {
        padding-bottom: 1.5rem !important;
    }

    .dash-table-wrapper .table-responsive {
        padding-bottom: 0.75rem !important;
    }

    .dash-table-wrapper .dt-container .dt-layout-row:last-child,
    .dash-table-wrapper .dataTables_wrapper .row:last-child {
        padding: 1.25rem 1.75rem 1.5rem 1.75rem !important;
    }
</style>

<main>


    <!-- Filter & Search Toolbar Card -->
    <div class="table-toolbar-card">
        <div class="filter-inputs-wrap">
            <div class="filter-item-date">
                <label class="form-field-label" for="filterTanggalAwal">Tanggal Awal</label>
                <input type="date" id="filterTanggalAwal" class="form-field-input">
            </div>
            <div class="filter-item-date">
                <label class="form-field-label" for="filterTanggalAkhir">Tanggal Akhir</label>
                <input type="date" id="filterTanggalAkhir" class="form-field-input">
            </div>
            <div class="filter-item-select">
                <label class="form-field-label" for="filterStatus">Status Kiriman</label>
                <select id="filterStatus" class="form-field-select">
                    <option value="">Semua Status</option>
                    <option value="Manifested">Manifested</option>
                    <option value="on_delivery">On Delivery</option>
                    <option value="delivered">Delivered</option>
                    <option value="returned">Returned</option>
                </select>
            </div>
            <div>
                <button type="button" id="btnFilter" class="btn btn-pos btn-filter-compact">
                    <i class="bi bi-funnel me-1"></i> Terapkan Filter
                </button>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="dash-table-wrapper">
        <!-- Top Row: Card Title (No icon) & Import Data Button -->
        <div class="table-card-topbar">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <h3 class="table-main-title">Data Kiriman</h3>
                <button type="button" class="btn btn-pos btn-import-action shadow-sm" id="btnTambah">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                    <span>Import Data</span>
                </button>
            </div>
        </div>

        <!-- Controls Toolbar Row Below Title: Length & Search -->
        <div class="table-controls-bar">
            <div class="table-controls-left">
                <div id="tableLengthContainer"></div>
            </div>
            <div class="table-controls-right">
                <div id="tableSearchContainer"></div>
            </div>
        </div>
        <div class="table-responsive p-0">
            <table id="paketTable" class="table table-hover w-100 mb-0" style="min-width: 900px;">
                <thead>
                    <tr>
                        <th class="text-center" width="50">No</th>
                        <th class="text-center">Nomor Kiriman</th>
                        <th class="text-center">Jenis Layanan</th>
                        <th class="text-center">Nama Penerima</th>
                        <th class="text-center">Telepon</th>
                        <th class="text-center">Berat (KG)</th>
                        <th class="text-center">Tanggal Ditambahkan</th>
                        <th class="text-center">Status</th>
                        <th class="text-center" style="width: 80px;">Aksi</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</main>

<!-- MODAL IMPORT KIRIMAN -->
<div class="modal fade" id="paketModal" tabindex="-1" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <span class="fw-semibold"><i class="bi bi-file-earmark-excel text-primary me-1"></i> Import Data Kiriman</span>
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4 pt-3">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:72px;height:72px;">
                        <i class="bi bi-cloud-arrow-up" style="font-size:1.8rem; color: var(--pos-blue);"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Upload File Excel</h6>
                    <p class="text-muted small mb-0">Import kiriman dari file Excel (.xlsx)</p>
                </div>

                <div class="upload-drop-zone rounded-4 p-5 text-center mb-2">
                    <input type="file" accept=".xlsx" id="fileExcel">
                    <div class="upload-icon mb-3">
                        <i class="bi bi-cloud-arrow-up-fill opacity-75" style="font-size: 3.5rem; color: var(--pos-blue);"></i>
                    </div>
                    <h6 class="fw-bold mb-1 text-dark">Klik atau drag &amp; drop file di sini</h6>
                    <p class="text-muted small mb-0">Format yang didukung: <b>.xlsx</b></p>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn text-secondary fw-medium px-4" data-bs-dismiss="modal">Batal</button>
                    <button type="button" id="btnMulaiUpload" class="btn btn-pos px-4 btn-pill fw-semibold shadow-sm d-flex align-items-center gap-2">
                        Preview Data
                    </button>
                </div>
            </div>
        </div>
