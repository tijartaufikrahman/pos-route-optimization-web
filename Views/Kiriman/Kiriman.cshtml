<script>
    $(document).ready(function () {
        const wibDateParts = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Asia/Jakarta',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        }).formatToParts(new Date());
        const todayWIB = wibDateParts.reduce(function (result, part) {
            result[part.type] = part.value;
            return result;
        }, {});
        const tanggalHariIni = todayWIB.year + '-' + todayWIB.month + '-' + todayWIB.day;

        $('#filterTanggalAwal').val(tanggalHariIni);
        $('#filterTanggalAkhir').val(tanggalHariIni);
        $('#filterStatus').val('');

        // =============================================
        // KONTROL TABEL: PINDAHKAN LENGTH & SEARCH KE TOOLBAR
        // =============================================
        function relocateTableControls() {
            var $wrap = $('#paketTable').closest('.dt-container');
            if (!$wrap.length) $wrap = $('#paketTable').closest('.dataTables_wrapper');

            var $length = $wrap.find('.dt-length, .dataTables_length');
            var $search = $wrap.find('.dt-search, .dataTables_filter');

            if ($length.length && !$('#tableLengthContainer').children().length) {
                $length.appendTo('#tableLengthContainer');
            }
            if ($search.length && !$('#tableSearchContainer').children().length) {
                $search.appendTo('#tableSearchContainer');
            }

            var $searchInput = $('#tableSearchContainer').find('input');
            if ($searchInput.length && !$searchInput.attr('placeholder')) {
                $searchInput.attr('placeholder', 'Ketik kata kunci...');
            }

            $wrap.find('> .row:first-child:not(.dt-layout-table)').hide();
            $wrap.find('.dt-layout-row:first-child:not(.dt-layout-table)').hide();
        }

        // =============================================
        // TABEL UTAMA: DAFTAR KIRIMAN
        // =============================================
        var mainTable = $('#paketTable').DataTable({
            columnDefs: [
                { targets: "_all", className: "text-center" }
            ],
            initComplete: function () {
                relocateTableControls();
            },
            drawCallback: function () {
                relocateTableControls();
            },
            columns: [
                { data: null, render: (d, t, r, m) => m.row + 1 },
                { data: 'no_kiriman', className: 'fw-bold' },
                { data: 'service' },
                { data: 'recipient_name' },
                { data: 'telepon_penerima' },
                { data: 'berat_kiriman' },
                {
                    data: 'created_at',
                    render: (data) => {
                        if (!data) return '-';
                        const tanggal = new Date(data);
                        const hari = String(tanggal.getDate()).padStart(2, '0');
                        const bulan = String(tanggal.getMonth() + 1).padStart(2, '0');
                        return hari + '/' + bulan + '/' + tanggal.getFullYear();
                    }
                },
                {
                    data: 'status',
                    render: (data) => {
                        const statuses = {
                            Manifested: { label: 'Manifested', className: 'status-manifested' },
                            manifested: { label: 'Manifested', className: 'status-manifested' },
                            on_delivery: { label: 'On Delivery', className: 'status-delivery' },
                            delivered: { label: 'Delivered', className: 'status-completed' },
                            Selesai: { label: 'Delivered', className: 'status-completed' },
                            returned: { label: 'Returned', className: 'status-returned' }
                        };
                        const status = statuses[data] || { label: data || '-', className: '' };
                        return '<span class="status-badge ' + status.className + '">' + status.label + '</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: (data, type, row) => {
                        if (row.isAction === 1) {
                            return `<button class="btn btn-sm btn-outline-danger" onclick="hapusKiriman(${row.id})" title="Hapus Kiriman"><i class="bi bi-trash"></i></button>`;
                        }
                        return '<span class="text-muted small">-</span>';
                    }
                }
            ]
        });

        // =============================================
        // LOAD DATA KIRIMAN
        // =============================================
        function loadPaket() {
            var tanggalAwal = $('#filterTanggalAwal').val();
            var tanggalAkhir = $('#filterTanggalAkhir').val();
            var status = $('#filterStatus').val();

            if (tanggalAwal && tanggalAkhir && tanggalAwal > tanggalAkhir) {
                alert('Tanggal awal tidak boleh melebihi tanggal akhir.');
                return;
            }

            var params = new URLSearchParams();
            if (tanggalAwal) params.set('tanggalAwal', tanggalAwal);
            if (tanggalAkhir) params.set('tanggalAkhir', tanggalAkhir);
            if (status) params.set('status', status);

            var query = params.toString();
            $.get(API_BASE_URL + '/api/paket/list-kiriman' + (query ? '?' + query : ''))
                .done(function (res) {
                    let dataUntukTable = res.data ? res.data : res;
                    if (Array.isArray(dataUntukTable)) {
                        mainTable.clear();
                        mainTable.rows.add(dataUntukTable);
                        mainTable.draw();
                        mainTable.columns.adjust();
                    } else {
                        console.warn("Format data bukan Array!", dataUntukTable);
                        mainTable.clear().draw();
                    }
                })
                .fail(function (err) {
                    console.error("Gagal load data", err);
                    alert("Koneksi ke API gagal/error.");
                });
        }

        loadPaket();

        $('#btnFilter').click(function () {
            loadPaket();
        });

        /* IMPORT KIRIMAN */
        $('#btnTambah').click(function () {
            new bootstrap.Modal(document.getElementById('paketModal')).show();
        });
    });

    // Hapus Kiriman
    function hapusKiriman(id) {
        if (!confirm('Yakin ingin menghapus kiriman ini?')) return;
        $.ajax({
            url: API_BASE_URL + '/api/paket/' + id,
            type: 'DELETE',
            success: function (res) {
                alert(res.message);
                window.location.reload();
            },
            error: function () {
                alert('Gagal menghapus kiriman');
            }
        });
    }
</script>

<script>
    let paketModalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('paketModal'));
    let previewModalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal'));
    let previewData = [];

    const KOLOM_WAJIB = [
        "No", "Nomor Kiriman", "IdPelanggan Korporat", "Kantor Kiriman", "Jenis Layanan",
        "COD/NON COD", "Tanggal Kirim", "Isi Kiriman", "Berat Kiriman", "Kriteria Kiriman",
        "Bea Dasar", "Nama Pengirim", "Telp Pengirim", "Alamat Pengirim", "Nama Penerima",
        "Telp Penerima", "Alamat Penerima"
    ];

    function normalisasiKolom(header) {
        return String(header || "").trim().toLowerCase().replace(/\s+/g, "");
    }

    function cekFileXlsx(file) {
        if (!file) {
            alert("Harap pilih file Excel terlebih dahulu!");
            return false;
        }
        const ekstensi = file.name.split(".").pop().toLowerCase();
        if (ekstensi !== "xlsx") {
            alert("File harus berformat .xlsx!");
            return false;
        }
        return true;
    }

    function cekKolomExcel(file, callback) {
        const reader = new FileReader();
        reader.onload = function (e) {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: "array" });
                const sheet = workbook.Sheets[workbook.SheetNames[0]];
                const json = XLSX.utils.sheet_to_json(sheet, { header: 1 });

                if (!json || json.length === 0) {
                    alert("File Excel kosong atau tidak memiliki baris header.");
                    callback(false);
                    return;
                }

                const headerFile = (json[0] || []).map(normalisasiKolom);
                const kolomKurang = KOLOM_WAJIB.filter(k => !headerFile.includes(normalisasiKolom(k)));

                if (kolomKurang.length > 0) {
                    alert("Format file tidak sesuai!");
                    callback(false);
                    return;
                }
                callback(true);
            } catch (err) {
                console.error("Gagal membaca file Excel:", err);
                alert("Gagal membaca file Excel. Pastikan file berformat .xlsx yang valid.");
                callback(false);
            }
        };
        reader.onerror = function () {
            alert("Gagal membaca file.");
            callback(false);
        };
        reader.readAsArrayBuffer(file);
    }

    $('#btnMulaiUpload').click(function () {
        let fileInput = $("#fileExcel")[0];
        let file = fileInput.files[0];
        if (!cekFileXlsx(file)) return;
        cekKolomExcel(file, function (valid) {
            if (!valid) return;
            prosesPreviewExcel(file);
        });
    });

    function prosesPreviewExcel(file) {
        paketModalInstance.hide();
        previewModalInstance.show();

        $("#tablePreviewContainer").hide();
        $("#loadingPreview").show();
        $("#tableBodyPreview").html("");

        let formData = new FormData();
        formData.append("file", file);

        $.ajax({
            url: API_BASE_URL + "/api/paket/upload-excel",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                $("#loadingPreview").hide();
                $("#tablePreviewContainer").show();

                let data = res.data || res;
                if (!data || data.length === 0) {
                    alert("File berhasil dibaca, namun kosong.");
                    return;
                }
                previewData = data.map(item => item.request_data);

                let rows = "";
                data.forEach((item, index) => {
                    let req = item.request_data;
                    let layananBadge = `<span class="badge badge-blue rounded-pill">${req.jenis_layanan}</span>`;

                    rows += `
                        <tr>
                            <td class="text-center text-muted">${index + 1}</td>
                            <td class="fw-bold text-dark">${req.nomor_kiriman ?? '-'}</td>
                            <td>${layananBadge}</td>
                            <td class="fw-medium">${req.nama_penerima ?? '-'}</td>
                            <td>
                                <span class="d-inline-block text-truncate" style="max-width: 200px;" title="${req.alamat_penerima ?? '-'}">
                                    ${req.alamat_penerima ?? '-'}
                                </span>
                            </td>
                            <td>${req.telepon_penerima ?? '-'}</td>
                            <td>${req.kriteria_kiriman}</td>
                            <td class="text-end pe-4">${req.berat_kiriman ?? 0}</td>
                            <td class="text-start d-none">${req.koordinat ?? '-'}</td>
                        </tr>
                    `;
                });

                $("#tableBodyPreview").html(rows);
            },
            error: function (err) {
                $("#loadingPreview").hide();
                alert("Gagal membaca file Excel! Pastikan format sesuai dan API berjalan.");
                console.log(err);
            }
        });
    }

    $("#btnSimpanExcelDB").click(function () {
        if (!previewData || previewData.length === 0) {
            alert("Tidak ada data preview yang bisa disimpan!");
            return;
        }

        let btn = $(this);
        let originalText = btn.html();
        btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Menyimpan...');

        $.ajax({
            url: API_BASE_URL + "/api/paket/bulk-insert",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(previewData),
            success: function (res) {
                alert("Data berhasil disimpan");
                btn.prop("disabled", false).html(originalText);
                previewModalInstance.hide();
                previewData = [];
                window.location.reload();
            },
            error: function (err) {
                btn.prop("disabled", false).html(originalText);
                alert("Gagal menyimpan data. Silakan coba lagi.");
                console.error("Error Detail:", err);
            }
        });
    });

    $('#paketModal').on('hidden.bs.modal', function () {
        $('#fileExcel').val('');
        previewData = [];
    });

    $('#previewModal').on('hidden.bs.modal', function () {
        $('#fileExcel').val('');
        previewData = [];
    });
</script>

<!-- UNTUK PETA GOOGLE -->
<script>
    let map, marker, geocoder, placesService;
    const defaultLocation = { lat: -7.0602586000, lng: 108.0876617000 };

    $('#btnMap').click(function () {
        new bootstrap.Modal(document.getElementById('mapModal')).show();
        setTimeout(() => {
            if (!map) {
                $.ajax({
                    url: API_BASE_URL + "/api/lokasi-kantor/getKantor",
                    type: 'GET',
                    success: function (data) {
                        if (data && data.latitude && data.longitude) {
                            defaultLocation.lat = data.latitude;
                            defaultLocation.lng = data.longitude;
                        } else {
                            defaultLocation.lat = 0;
                            defaultLocation.lng = 0;
                        }
                        initMap();
                        if (!data || !data.latitude || !data.longitude) {
                            map.setZoom(2);
                            $("#latitude").val('');
                            $("#longitude").val('');
                        }
                    },
                    error: function () {
                        defaultLocation.lat = 0;
                        defaultLocation.lng = 0;
                        initMap();
                        map.setZoom(2);
                        $("#latitude").val('');
                        $("#longitude").val('');
                    }
                });
            } else {
                google.maps.event.trigger(map, 'resize');
                map.setCenter(marker.getPosition());
            }
        }, 500);
    });

    function initMap() {
        geocoder = new google.maps.Geocoder();
        map = new google.maps.Map(document.getElementById("map"), {
            center: defaultLocation,
            zoom: 15,
            mapTypeControl: false,
            streetViewControl: false,
            fullscreenControl: false
        });
        placesService = new google.maps.places.PlacesService(map);
        marker = new google.maps.Marker({
            position: defaultLocation,
            map: map,
            draggable: true
        });

        $("#latitude").val(defaultLocation.lat);
        $("#longitude").val(defaultLocation.lng);

        map.addListener("click", function (event) {
            marker.setPosition(event.latLng);
            $("#latitude").val(event.latLng.lat());
            $("#longitude").val(event.latLng.lng());
        });

        marker.addListener("dragend", function (event) {
            $("#latitude").val(event.latLng.lat());
            $("#longitude").val(event.latLng.lng());
        });
    }

    $("#btnGeocoding").on("click", function () {
        const address = $("#searchInput").val();
        if (!address) {
            alert("Masukkan alamat terlebih dahulu");
            return;
        }
        geocoder.geocode({ address: address }, function (results, status) {
            if (status === "OK") {
                const location = results[0].geometry.location;
                map.setCenter(location);
                map.setZoom(17);
                marker.setPosition(location);
                $("#latitude").val(location.lat());
                $("#longitude").val(location.lng());
            } else {
                alert("Geocoding gagal: " + status);
            }
        });
    });

    $("#btnPlaces").on("click", function () {
        const query = $("#searchInput").val();
        if (!query) {
            alert("Masukkan lokasi terlebih dahulu");
            return;
        }
        const request = { query: query, fields: ["name", "geometry"] };
        placesService.findPlaceFromQuery(request, function (results, status) {
            if (status === google.maps.places.PlacesServiceStatus.OK && results.length > 0) {
                const location = results[0].geometry.location;
                map.setCenter(location);
                map.setZoom(17);
                marker.setPosition(location);
                $("#latitude").val(location.lat());
                $("#longitude").val(location.lng());
            } else {
                alert("Places gagal: " + status);
            }
        });
    });

    $("#btnSaveLocation").on("click", function () {
        const lat = $("#latitude").val();
        const lng = $("#longitude").val();
        $("#koordinat").val(lat + ", " + lng);
        bootstrap.Modal.getInstance(document.getElementById("mapModal")).hide();
    });
</script>