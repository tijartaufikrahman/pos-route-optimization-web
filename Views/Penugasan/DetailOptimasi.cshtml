@{
    ViewData["Title"] = "Optimasi Pengantaran";
    var modeRingkas = ViewData["ModeRingkas"] as bool? == true;
}

<style>
    .card-custom {
        background: #ffffff;
        border-radius: var(--pos-radius);
        border: 1px solid var(--pos-border);
        box-shadow: var(--pos-shadow);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-header-simple {
        padding: 14px 20px;
        border-bottom: 1px solid var(--pos-border);
        background-color: #ffffff;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--pos-blue);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    #map {
        height: 400px;
        width: 100%;
        border-radius: var(--pos-radius-sm);
        background-color: #F1F5F9;
        border: 1px solid var(--pos-border);
        z-index: 1;
    }

    .btn-brand {
        background-color: var(--pos-orange);
        color: white;
        font-weight: 600;
        border-radius: var(--pos-radius-sm);
        padding: 10px 20px;
        border: none;
        transition: all 0.2s ease;
    }

    .btn-brand:hover {
        background-color: var(--pos-orange-hover);
        color: white;
    }

    .btn-brand:disabled {
        background-color: #CBD5E1;
        color: #94A3B8;
    }

    .btn-primary-custom {
        background-color: var(--pos-blue);
        color: white;
        font-weight: 600;
        border-radius: var(--pos-radius-sm);
        padding: 10px 20px;
        border: none;
        transition: all 0.2s;
    }

    .btn-primary-custom:hover {
        background-color: var(--pos-blue-hover);
        color: white;
    }

    .btn-outline-custom {
        border: 1px solid var(--pos-border);
        color: var(--pos-text);
        font-weight: 600;
        border-radius: var(--pos-radius-sm);
        padding: 10px 20px;
        background: white;
        transition: all 0.2s;
    }

    .btn-outline-custom:hover {
        background-color: #F8FAFC;
    }

    /* Styling Custom Tabs */
    .custom-tabs {
        display: flex;
        border-bottom: 2px solid var(--pos-border);
        margin-bottom: 16px;
        gap: 4px;
    }

    .tab-btn {
        background: none;
        border: none;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--pos-text-muted);
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .tab-btn:hover {
        color: var(--pos-blue);
    }

    .tab-btn.active {
        color: var(--pos-blue);
        border-bottom: 2px solid var(--pos-blue);
    }

    .table-container {
        padding: 0 20px 20px 20px;
    }

    .seq-number {
        background: var(--pos-blue);
        color: white;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 0.72rem;
        font-weight: bold;
    }

    .badge-count {
        padding: 2px 7px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .badge-success-soft {
        background-color: #DCFCE7;
        color: #15803D;
    }

    .badge-warning-soft {
        background-color: #FEF3C7;
        color: #B45309;
    }

    .badge-primary-soft {
        background-color: #DBEAFE;
        color: #1D4ED8;
    }

    .badge-danger-soft {
        background-color: #FEE2E2;
        color: #B91C1C;
    }

    /* Tombol toggle garis rute di peta */
    .rute-toggle-btn {
        width: 34px;
        height: 34px;
        padding: 0 !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    .toggle-line {
        display: block;
        width: 18px;
        height: 3px;
        border-radius: 2px;
    }

    /* Loader full layar */
    .loader-fullscreen {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(3px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loader-box {
        background: #FFFFFF;
        border-radius: 12px;
        padding: 32px 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .loader-text {
        margin-top: 14px;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--pos-blue);
    }

    /* Hasil optimasi cards */
    .info-section-title {
        display: flex;
        align-items: center;
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--pos-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .info-tile {
        background: var(--pos-bg);
        border: 1px solid var(--pos-border);
        border-radius: var(--pos-radius-sm);
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        height: 100%;
    }

    .tile-icon {
        width: 38px;
        height: 38px;
        border-radius: var(--pos-radius-sm);
        background: rgba(27, 44, 89, 0.08);
        color: var(--pos-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .tile-label {
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--pos-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .tile-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--pos-blue);
        line-height: 1.2;
    }

    .time-breakdown {
        border: 1px solid var(--pos-border);
        border-radius: var(--pos-radius-sm);
        background: #fff;
        overflow: hidden;
    }

    .time-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--pos-border);
    }

    .time-row:last-child {
        border-bottom: none;
    }

    .time-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--pos-blue);
        flex-shrink: 0;
    }

    .time-row-name {
        font-weight: 500;
        font-size: 0.82rem;
        color: var(--pos-text);
    }

    .time-row-value {
        margin-left: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: right;
    }

    .time-value {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--pos-blue);
    }

    .time-row-total {
        background: rgba(27, 44, 89, 0.04);
    }

    .time-row-total .time-row-name {
        font-weight: 700;
        color: var(--pos-blue);
    }

    .compact-optimasi .card-custom {
        border-radius: var(--pos-radius-sm);
        border-color: var(--pos-border);
        box-shadow: var(--pos-shadow);
    }
</style>
<div class="container-fluid px-0 @(modeRingkas ? "compact-optimasi" : "")">

    <div class="breadcrumb-bar">
        <a href="/Penugasan/OptimasiPengantaran"><i class="bi bi-map-fill"></i> Optimasi Rute</a>
        <span class="sep">/</span>
        <span class="current">Detail</span>
    </div>

    <div class="row pb-5">



        <div class="col-lg">
            <div class="card card-custom" id="pengaturanOptimasi">
                <div class="card-header-simple">
                    <span>Sebaran Titik Pengantaran</span>
                </div>
                <div class="card-body p-4 ">
                    <div id="map" style="height:625px;"></div>
                </div>
            </div>

            <div class="card card-custom">
                <div class="card-header-simple border-0 pb-0 pt-4 bg-white">
                    <span id="tableTitle"> Daftar  Kiriman</span>
                </div>

                <div class="card-body table-container pt-3">

                    <div class="custom-tabs" id="kirimanTabs" style="display: none;">
                        <button class="tab-btn" data-type="route" style="display: none;">
                            <i class="bi bi-signpost-split-fill"></i> Urutan Pengantaran
                            <span class="badge-count badge-primary-soft" id="countRoute">0</span>
                        </button>
                        <button class="tab-btn active" data-type="valid">
                            <i class="bi bi-geo-alt-fill"></i> Titik Lokasi tersedia
                            <span class="badge-count badge-success-soft" id="countValid">0</span>
                        </button>
                        <button id="belumdioptimasi" class="tab-btn" data-type="unoptimized">
                            <i class="bi bi-clock-history"></i> Belum Dioptimasi
                            <span class="badge-count badge-warning-soft" id="countUnoptimized">0</span>
                        </button>
                        <button class="tab-btn" data-type="invalid">
                            <i class="bi bi-exclamation-triangle-fill"></i> Titik Lokasi Tidak Tersedia
                            <span class="badge-count badge-danger-soft" id="countInvalid">0</span>
                        </button>
                    </div>

                    <div id="alertRoute" class="alert alert-primary py-2 px-3 mt-2 mb-3" style="font-size: 0.85rem; display: none;">
                        <i class="bi bi-info-circle-fill me-2"></i>Urutan pengantaran.
                    </div>
                    <div id="alertValidInfo" class="alert alert-info py-2 px-3 mt-2 mb-3" style="font-size: 0.85rem; display: none;">
                        <i class="bi bi-info-circle-fill me-2"></i>Kiriman yang <b>memiliki titik lokasi pengantaran </b>
                    </div>
                    <div id="alertUnoptimized" class="alert alert-warning py-2 px-3 mt-2 mb-3" style="font-size: 0.85rem; display: none;">
                        <i class="bi bi-info-circle-fill me-2"></i>Data ini memiliki titik lokasi pengantaran namun <b>belum diikutsertakan</b> dalam optimasi rute.
                    </div>
                    <div id="alertInvalid" class="alert alert-danger py-2 px-3 mt-2 mb-3" style="font-size: 0.85rem; display: none;">
                        <i class="bi bi-info-circle-fill me-2"></i>Data ini <b>tidak memiliki titik lokasi pengantaran</b>, sehingga tidak dapat diikutsertakan dalam optimasi rute.
                    </div>

                    <div class="table-responsive">
                        <table id="tableKiriman" class="table table-hover">
                            <thead id="theadKiriman">
                                <tr>
                                    <th style="width: 50px;" class="text-center">No</th>
                                    <th>No Kiriman</th>
                                    <th>Penerima</th>
                                    <th>No Telp</th>
                                    <th>Alamat Lengkap</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyKiriman">
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="text-muted" style="font-size: 0.95rem;">
                                            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem; color: #CBD5E1;"></i>
                                            Tidak ada data kiriman.
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">

            <div class="card card-custom">
                <div class="card-header-simple">
                    <span>Informasi Penugasan</span>
                </div>
                <div class="card-body p-4">
                    <div class="">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">ID PENUGASAN : </label>
                        <label id="idPenugasan" class="form-label text-muted  " style="font-size: 0.8rem;">-</label>
                    </div>

                    <div class="">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">ORANGER ANTARAN : </label>
                        <label id="idnama" class="form-label text-muted fw-normal " style="font-size: 0.8rem;">-</label>
                    </div>

                    <div class="">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">TANGGAL PENUGASAN : </label>
                        <label id="tanggal" class="form-label text-muted fw-normal " style="font-size: 0.8rem;">-</label>
                    </div>

                    <div class="">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">TOTAL KIRIMAN : </label>
                        <label id="total" class="form-label text-muted fw-normal " style="font-size: 0.8rem;">-</label>
                    </div>

                    <div id="btnSetKurir" class=""></div>
                </div>
            </div>

            <div class="card card-custom">
                <div class="card-header-simple">
                    <span></span>
                </div>
                <div class="card-body px-4 py-3">
                    <div id="hisAlgo" class="d-none mb-4">
                        <button type="button" class="btn btn-outline-custom w-100" data-bs-toggle="modal" data-bs-target="#modalHistoriACO">
                            <i class="bi bi-graph-up-arrow me-2"></i>
                            Lihat Histori Algoritma
                        </button>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">
                            Algoritma Optimasi
                        </label>
                        <select class="form-select" id="jenisAlgoritma">
                            <option value="ant" selected>
                                Ant Colony Optimization - 2 Opt
                            </option>

                            <option value="nn">
                                Neirest Neigboard
                            </option>

                            <option value="ge">
                                Genetika - 2 Opt
                            </option>

                            
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">Jenis Kendaraan</label>
                        <select class="form-select" id="" disabled>
                            <option value="tercepat">Mobil</option>
                            <option value="terpendek" selected>Sepeda Motor (Roda 2)</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.8rem;">WAKTU BERHENTI PER TITIK (MENIT)</label>
                        <input type="number" class="form-control" disabled id="waktuBerhenti" value="5" min="0">
                    </div>

                    <p id="infoOptimasi" class="text-muted mb-3" style="font-size: 0.75rem;">

                    </p>

                    <button type="button" id="btnProses" class="btn btn-brand w-100" disabled>
                        Mulai Optimasi Rute
                    </button>
                    <p class="mt-3 text-muted mb-3" style="font-size: 0.75rem;">
                        <i class="bi bi-info-circle me-1"></i>Hanya memproses kiriman yang memiliki lokasi titik lokasi (koordinat).
                    </p>
                </div>
            </div>

            <div class="card card-custom" id="hasilOptimasi" style="display: none;">
                <div class="d-none card-header-simple">
                    <span>
                        <i class="bi bi-graph-up-arrow me-2" style="color: var(--pos-blue);"></i>
                        Ringkasan Estimasi
                        </span>
                    <span class="d-none badge-count badge-primary-soft">
                        <!--<i class="bi bi-geo-alt-fill me-1"></i>-->
                        <span id="optCount">0</span> Titik
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="info-section-title">
                        <i class="bi bi-signpost-split-fill me-1"></i> Informasi Perjalanan
                    </div>

                    <div class="info-tile mb-3">
                        <div class="tile-icon">
                            <i class="bi bi-arrow-left-right"></i>
                        </div>
                        <div>
                            <div class="tile-label">Total Jarak</div>
                            <div class="tile-value" id="optJarakKesimpulan2">0 km</div>
                        </div>
                    </div>

                    <div class="info-tile">
                        <div class="tile-icon">
                            <i class="bi bi-stopwatch"></i>
                        </div>
                        <div>
                            <div class="tile-label">Estimasi Waktu</div>
                            <div class="tile-value" id="optWaktuJalan" style="white-space: nowrap;">0 menit</div>
                            <div class="tile-sub d-none" id="optWaktuJalanJam"></div>
                        </div>
                    </div>

                    <div class="info-section-title mt-4">
                        <i class="bi bi-clock-history me-1"></i> Rincian Waktu
                    </div>

                    <div class="time-breakdown">
                        <div class="time-row">
                            <span class="time-dot"></span>
                            <div class="time-row-name">Waktu Perjalanan</div>
                            <div class="time-row-value">
                                <div class="time-value"><span id="optWaktuJalan2" style="white-space: nowrap;">0 menit</span></div>
                                <div class="time-sub d-none" id="optWaktuJalanJam2"></div>
                            </div>
                        </div>

                        <div class="time-row">
                            <span class="time-dot"></span>
                            <div class="time-row-name">Waktu Berhenti</div>
                            <div class="time-row-value">
                                <div class="time-value" id="optWaktuBerhenti">0 menit</div>
                                <div class="time-sub" id="optWaktuBerhentiMnt"></div>
                            </div>
                        </div>

                        <div class="time-divider"></div>

                        <div class="time-row time-row-total">
                            <div class="time-row-name">Total Estimasi</div>
                            <div class="time-row-value">
                                <div class="time-value" id="optWaktuKesimpulan">0 menit</div>
                                <div class="time-sub d-none" id="optWaktuKesimpulanMnt"></div>
                            </div>
                        </div>
                    </div>

                    <button type="button" id="btnSimpan" class="btn btn-primary-custom w-100 shadow-sm mt-4">
                        <i class="bi bi-floppy-fill me-2"></i>Simpan Penugasan
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>




<!--Loader Full Screen-->
<div id="loaderOptimasi" class="loader-fullscreen" style="display: none;">
    <div class="loader-box">
        <div class="spinner-border" role="status" style="width: 3.5rem; height: 3.5rem; color: #003366;"></div>
        <p class="fw-normal loader-text">Memproses Informasi...</p>
    </div>
</div>

<!--Modal-->
<div class="modal fade" id="modalHistoriACO" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width: 92%;">
        <div class="modal-content border-0" style="border-radius:10px;overflow:hidden;border:1px solid #185FA5;">
            <!-- HEADER -->
            <div class="modal-header border-0 p-0">
                <div style="background:#003366;width:100%;padding:16px 20px;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 id="titleHistoryAlgo" class="modal-title mb-1" style="color:#fff;font-weight:500;font-size:15px;">Histori Iterasi ACO</h5>
                            <small id="subTitleHistoryAlgo" style="color:rgba(255,255,255,0.6);">Monitoring konvergensi dan perubahan solusi</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <!-- TAB -->
                    <div style="background:#fff;border-radius:10px 10px 0px 0px;margin-top:20px;position:relative;">
                        <div class="d-flex position-relative">
                            <div id="historyTabIndicator" style="position:absolute;bottom:0;left:0;width:50%;height:2px;background:#003366;transition:all .3s ease;"></div>

                            <!-- ACO -->
                            <div id="btnTabACO" class="flex-fill text-center" style="padding:14px 10px;cursor:pointer;font-size:13px;font-weight:500; color:#003366;z-index:2; ">
                                Ant Colony Optimization (ACO)
                            </div>
                            <!-- 2OPT -->
                            <div id="btnTab2Opt" class="flex-fill text-center" style="padding:14px 10px;cursor:pointer;font-size:13px;font-weight:400;color:#777;z-index:2;">
                                2-Opt First Improvement
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="font-size:16px;">
                        <thead style="background:#fff;">
                            <tr>
                                <th class="text-center" style="padding:10px 14px;width:80px;">Iterasi</th>
                                <th id="s" style="padding:10px 14px;">Swap</th>
                                <th style="padding:10px 14px;">Jarak Terbaik</th>
                                <th style="padding:10px 14px;">Waktu</th>
                                <th style="padding:10px 14px;">Status</th>
                                <th style="padding:10px 14px;">Rute Terbaik</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyHistoryACO">
                            <tr>
                                <td colspan="6" class="text-center py-5" style="color:#888;">Belum ada data histori iterasi</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0" style="background:#fff;border-top:1px solid #b5d4f4 !important;">
                <button type="button" class="btn btn-sm" style="background:#003366;color:#fff;border:none;border-radius:6px;padding:5px 16px;font-size:12px;" data-bs-dismiss="modal">
                    Tutup
                </button>
            </div>
        </div>
    </div>
</div>
<!--EndModal-->
@section Scripts {
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.2.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.2.0/mapbox-gl.js"></script>

    <script>
        let map;
        let markers = []; // Array untuk menampung marker objek Mapbox

        let currentValidData = [];
        let currentInvalidData = [];
        let isOptimized = false;
        let optimasiTersimpan = false; // true = hasil optimasi sudah disimpan di server

        let hasilOptimasiGlobal = [];
        let savedApiOptimasi = null;
        let savedApiRouting = null;

        const urlParams = new URLSearchParams(window.location.search);
        const penugasanId = urlParams.get('penugasanId');

        let KANTOR_POS = '';
        // const KANTOR_POS = { id: 0, nama: "Pusat Operasional", alamat: "Kantor Pusat", lat: -7.053, lng: 108.086 };

        // Fungsi bantuan format waktu
        function formatDetik(detik) {
            if (!detik || detik <= 0) return '<span style="white-space: nowrap; color: var(--pos-blue);">0 <span class="fs-6 fw-normal">menit</span></span>';
            const totalMenit = Math.floor(detik / 60);
            const sisaDetik = Math.round(detik % 60);
            const jam = Math.floor(totalMenit / 60);
            const sisaMenit = totalMenit % 60;
            const parts = [];
            if (jam > 0) parts.push(`<span style="white-space: nowrap; color: var(--pos-blue);">${jam} <span class="fs-6 fw-normal">jam</span></span>`);
            if (sisaMenit > 0) parts.push(`<span style="white-space: nowrap; color: var(--pos-blue);">${sisaMenit} <span class="fs-6 fw-normal">menit</span></span>`);
            if (sisaDetik > 0) parts.push(`<span style="white-space: nowrap; color: var(--pos-blue);">${sisaDetik} <span class="fs-6 fw-normal">detik</span></span>`);
            return parts.join(' ');
        }

        function formatJam(totalMenit) {
            if (!totalMenit || totalMenit <= 0) return '<span style="white-space: nowrap; color: var(--pos-blue);">0 <span class="fs-6 fw-normal">menit</span></span>';
            const jam = Math.floor(totalMenit / 60);
            const menit = Math.round(totalMenit % 60);
            const parts = [];
            if (jam > 0) parts.push(`<span style="white-space: nowrap; color: var(--pos-blue);">${jam} <span class="fs-6 fw-normal">jam</span></span>`);
            if (menit > 0) parts.push(`<span style="white-space: nowrap; color: var(--pos-blue);">${menit} <span class="fs-6 fw-normal">menit</span></span>`);
            return parts.join(' ');
        }

        // Fungsi bantuan format jarak: < 1 km tampil "X meter", >= 1 km tampil "X km Y meter" (hanya angka yang bold)
        function formatJarak(km) {
            if (!km || km <= 0) return `0 <span class="fw-normal">meter</span>`;
            const totalMeter = Math.round(km * 1000);
            if (totalMeter < 1000) return `${totalMeter} <span class="fw-normal">meter</span>`;
            const kmPart = Math.floor(totalMeter / 1000);
            const mPart = totalMeter % 1000;
            if (mPart === 0) return `${kmPart} <span class="fw-normal">km</span>`;
            return `${kmPart} <span class="fw-normal">km</span> ${mPart} <span class="fw-normal">meter</span>`;
        }

