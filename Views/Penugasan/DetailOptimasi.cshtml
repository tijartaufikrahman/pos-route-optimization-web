        // Fungsi bantuan untuk membuat custom marker di Mapbox
        function tambahMarkerMapbox(lng, lat, popupHtml, isDepot, urutan = null) {
            const el = document.createElement('div');
            el.className = 'custom-mapbox-marker';

            if (isDepot) {
                el.innerHTML = `<div style="background-color:#1e3a8a; color:white; border-radius:50%; width:26px; height:26px; display:flex; align-items:center; justify-content:center; font-weight:bold; border:2px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">P</div>`;
            } else {
                el.innerHTML = `<div style="background-color:#FF5A00; color:white; border-radius:50%; width:22px; height:22px; display:flex; align-items:center; justify-content:center; font-weight:bold; border:2px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">${urutan || ''}</div>`;
            }

            const popup = new mapboxgl.Popup({ offset: 25 }).setHTML(popupHtml);

            const marker = new mapboxgl.Marker(el)
                .setLngLat([lng, lat])
                .setPopup(popup)
                .addTo(map);

            markers.push(marker);
        }


        // LOAD HASIL OPTIMASI TERSIMPAN
        function loadSavedOptimization(data) {

            // Hanya proses item yang memiliki nomor_urutan (pernah dioptimasi)
            const validOptimizedData = data.filter(item => item.nomor_urutan != null);

            const orderedData = validOptimizedData
                .sort((a, b) => a.nomor_urutan - b.nomor_urutan);

            const orderedLocations = orderedData.map(x => ({
                lat: x.paket.latitude,
                lon: x.paket.longitude
            }));

            $.ajax({
                url: API_BASE_URL + '/api/optimization/calculate',
                method: 'POST',
                contentType: 'application/json',

                data: JSON.stringify({
                    locations: orderedLocations
                }),

                success: function (calcResult) {
                    // console.log(calcResult);

                    const orderedPakets = orderedData.map((x, index) => ({
                        paketId: x.paket.id,
                        order: index + 1,
                        lat: x.paket.latitude,
                        lon: x.paket.longitude
                    }));

                    const apiOptimasi = {
                        orderedPakets: orderedPakets,
                        segments: calcResult.segments,
                        totalDistance: calcResult.totalDistance,
                        totalDuration: calcResult.totalDuration
                    };

                    const apiRouting = {
                        polylines: calcResult.polylines
                    };

                    renderHasilOptimasi(apiOptimasi, apiRouting);
                },

                error: function (xhr) {
                    console.log(xhr);
                    alert("Gagal load optimasi tersimpan!");
                }
            });
        }




