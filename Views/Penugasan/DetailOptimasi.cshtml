        // === TOMBOL TOGGLE GARIS RUTE DI PETA ===
        let ruteVisible = true; // garis rute asli (biru)

        class RuteToggleControl {
            onAdd(map) {
                this._map = map;
                this._container = document.createElement('div');
                this._container.className = 'mapboxgl-ctrl mapboxgl-ctrl-group';

                this._btnRute = this._buatTombol('#0d6efd', 'Sembunyikan garis rute (biru)', () => this.toggleRute());

                this._container.appendChild(this._btnRute);
                return this._container;
            }
            _buatTombol(warna, title, handler) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'rute-toggle-btn';
                btn.title = title;
                btn.innerHTML = `<span class="toggle-line" style="background:${warna};"></span>`;
                btn.addEventListener('click', handler);
                return btn;
            }
            toggleRute() {
                ruteVisible = !ruteVisible;
                this._setVisibility('route-layer', ruteVisible);
                this._btnRute.title = ruteVisible ? 'Sembunyikan garis rute (biru)' : 'Tampilkan garis rute (biru)';
                this._btnRute.classList.toggle('rute-hidden', !ruteVisible);
            }
            _setVisibility(layerId, visible) {
                if (this._map.getLayer(layerId)) {
                    this._map.setLayoutProperty(layerId, 'visibility', visible ? 'visible' : 'none');
                }
            }
            onRemove() {
                if (this._container.parentNode) this._container.parentNode.removeChild(this._container);
            }
        }

