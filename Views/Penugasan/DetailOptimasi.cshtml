        // === FUNGSI RENDER ULANG TABEL OPTIMASI (untuk tab switching) ===
        function renderOptimizedRouteTable() {
            const apiOptimasi = savedApiOptimasi;
            const apiRouting = savedApiRouting;
            if (!apiOptimasi || !apiRouting) return;

            const dictPaket = {};
            currentValidData.forEach(item => { dictPaket[item.paket.id] = item.paket; });

            const orderedPakets = apiOptimasi.orderedPakets;
            const segments = apiOptimasi.segments;

            $('#tableTitle').html('<i class="bi bi-signpost-split-fill me-2" style="color: var(--pos-orange);"></i> Urutan Pengantaran ');

            $('#theadKiriman').html(`
                    <tr>
                        <th style="width: 50px;" class="text-center">Urutan</th>
                        <th>No Kiriman</th>
                        <th>Tujuan</th>
                        <th class="">Jarak</th>
                                <th class="">Estimasi Waktu</th>
                    </tr>
                `);

            const tbody = $('#tbodyKiriman').empty();
            clearMarkersAndRoute();

            let bounds = new mapboxgl.LngLatBounds();

            tambahMarkerMapbox(KANTOR_POS.lng, KANTOR_POS.lat, "<b>KANTOR POS PUSAT</b>", true);
            bounds.extend([KANTOR_POS.lng, KANTOR_POS.lat]);

            tbody.append(`
                    <tr class="table-row-text bg-light">
                        <td class="text-center"><span class="badge bg-primary">START</span></td>
                        <td><span class="fw-bold" style="color: var(--pos-blue);">KANTOR</span></td>
                        <td><div>-</div></td>
                        <td class=" align-middle"><span class="text-muted">-</span></td>
                        <td class="text-end align-middle"><span class="text-muted">-</span></td>
                    </tr>
                `);

            orderedPakets.forEach((opt, index) => {
                const pDetail = dictPaket[opt.paketId];
                const urutan = opt.order;
                const seg = segments[index];

                tambahMarkerMapbox(opt.lon, opt.lat, `<b>Urutan ${urutan}</b><br>${pDetail.no_kiriman}<br>${pDetail.recipient_name}`, false, urutan);
                bounds.extend([opt.lon, opt.lat]);

                let distHtml = '<span class="text-muted">-</span>';
                let timeHtml = '<span class="text-muted">-</span>';
                if (seg) {
                    let travelTimeFormatted = formatDetik(seg.duration);
                    let teksDari = index === 0 ? "Kantor Pos" : `Titik ${index}`;
                    distHtml = `<div class="text-muted" style="font-size: 0.7rem;white-space: nowrap;">dari ${teksDari}</div><div class="fw-bold" style="color: var(--text-main);white-space: nowrap;">${formatJarak(seg.distance)}</div>`;
                    timeHtml = `<div class="text-muted" style="font-size: 0.7rem;white-space: nowrap;">dari ${teksDari}</div><div class="fw-bold" style="color: var(--pos-orange);white-space: nowrap;">${travelTimeFormatted}</div>`;
                }

                tbody.append(`
                        <tr class="table-row-text">
                            <td class="text-center"><span class="seq-number shadow-sm">${urutan}</span></td>
                            <td><span class="fw-bold" >${pDetail.no_kiriman}</span></td>
                            <td class="">
                                <div>${pDetail.recipient_name}</div>
                                <div class="text-muted" style="font-size:0.75rem;">${pDetail.address}</div>
                                <div class="text-muted" style="font-size:0.75rem;white-space: nowrap;">${pDetail.telepon|| '-'}</div>
                            </td>
                            <td class=" align-middle">${distHtml}</td>
                            <td class="align-middle">${timeHtml}</td>
                        </tr>
                    `);
            });

            const lastSeg = segments[segments.length - 1];
            let lastDist = lastSeg ? formatJarak(lastSeg.distance) : '0 m';
            let lastTimeFormatted = lastSeg ? formatDetik(lastSeg.duration) : '0 menit';
            tbody.append(`
                    <tr class="table-row-text bg-light">
                        <td class="text-center"><span class="badge bg-secondary">FINISH</span></td>
                        <td><span class="fw-bold" style="color: var(--pos-blue);">KANTOR POS</span></td>
                        <td><div>-</div></td>
                        <td class="align-middle">
                                    <div class="text-muted" style="font-size: 0.7rem;white-space: nowrap;">dari Titik ${orderedPakets.length}</div>
                                    <div class="fw-bold" style="color: var(--text-main);white-space: nowrap;">${lastDist}</div>
                        </td>
                        <td class="align-middle">
                                    <div class="text-muted" style="font-size: 0.7rem;white-space: nowrap;">dari Titik ${orderedPakets.length}</div>
                                    <div class="fw-bold" style="color: var(--pos-orange);white-space: nowrap;">${lastTimeFormatted}</div>
                        </td>
                    </tr>
                `);

            // Gambar polyline rute (biru) jika berhasil decode
            let features = [];
            let berhasilDecode = false;

            let routingData = apiRouting;
            if (typeof routingData === 'string') {
                try { routingData = JSON.parse(routingData); } catch (e) { console.error("Gagal parse", e); }
            }

            if (routingData && (routingData.routes || routingData.polylines)) {
                const routeList = routingData.routes || routingData.polylines;
                routeList.forEach((route, idx) => {
                    let polylineString = null;
                    if (typeof route === 'string') {
                        polylineString = route;
                    } else {
                        polylineString = route.polyline || route.geometry || (route.overview_polyline ? route.overview_polyline.points : null);
                    }
                    if (polylineString && typeof polylineString === 'string') {
                        const decodedPath = decodePolyline(polylineString, 6);
                        if (decodedPath.length > 0) {
                            berhasilDecode = true;
                            features.push({
                                'type': 'Feature',
                                'properties': { 'segment': idx },
                                'geometry': {
                                    'type': 'LineString',
                                    'coordinates': decodedPath
                                }
                            });
                        }
                    }
                });
            }

            // Lapisan rute asli (biru) — hanya jika polyline berhasil diproses
            if (berhasilDecode) {
                map.addSource('route-source', {
                    'type': 'geojson',
                    'data': {
                        'type': 'FeatureCollection',
                        'features': features
                    }
                });
                map.addLayer({
                    'id': 'route-layer',
                    'type': 'line',
                    'source': 'route-source',
                    'layout': {
                        'line-join': 'round',
                        'line-cap': 'round'
                    },
                    'paint': {
                        'line-color': '#0d6efd',
                        'line-width': 5,
                        'line-opacity': 0.85
                    }
                });

                // Jika garis rute sedang disembunyikan, pertahankan statusnya
                if (!ruteVisible) {
                    map.setLayoutProperty('route-layer', 'visibility', 'none');
                }
            } else {
                console.warn("Polyline asli gagal diproses; hanya garis lurus antar titik (merah) yang digambar.");
            }

            map.fitBounds(bounds, { padding: 60, maxZoom: 15 });
        }

        // === 3. FUNGSI RENDER HASIL OPTIMASI ===
        function renderHasilOptimasi(apiOptimasi, apiRouting) {
            const dictPaket = {};
            currentValidData.forEach(item => { dictPaket[item.paket.id] = item.paket; });

            const orderedPakets = apiOptimasi.orderedPakets;

            hasilOptimasiGlobal = orderedPakets;

            const segments = apiOptimasi.segments || [];
            const waktuBerhenti = 5;
            const totalJarak = segments.length
                ? segments.reduce((total, segment) => total + Number(segment.distance || 0), 0)
                : Number(apiOptimasi.totalDistance || 0);
            const totalDurasiDetik = segments.length
                ? segments.reduce((total, segment) => total + Number(segment.duration || 0), 0)
                : Number(apiOptimasi.totalDuration || 0);

            // Tampilkan tabs - route tab jadi default
            $('#kirimanTabs').show();
            $('.tab-btn[data-type="route"]').show();
            $('.tab-btn').removeClass('active');
            $('.tab-btn[data-type="route"]').addClass('active');
            // Hitung ulang: items dengan koordinat tapi tanpa nomor_urutan masuk ke tab unoptimized
            const unoptimizedWithCoords = currentValidData.filter(item => item.nomor_urutan == null).length;
            const optimizedCount = orderedPakets.length;
            $('#countRoute').text(optimizedCount);
            $('#countValid').text(optimizedCount);
            $('#countUnoptimized').text(unoptimizedWithCoords);

            // Tampilkan tab "Belum Dioptimasi" HANYA jika optimasi sudah tersimpan & jumlahnya > 0
            if (optimasiTersimpan && unoptimizedWithCoords > 0) {
                $('#belumdioptimasi').removeClass('d-none');
            } else {
                $('#belumdioptimasi').addClass('d-none');
            }

            $('#countInvalid').text(currentInvalidData.length);

            // Simpan data optimasi untuk tab switching
            savedApiOptimasi = apiOptimasi;
            savedApiRouting = apiRouting;

            $('#alertInvalid, #alertValidInfo, #alertUnoptimized').hide();
            $('#alertRoute').fadeIn(200);

            // Render tabel + map optimasi (untuk tab route)
            renderOptimizedRouteTable();


            let totalTravelTimeMins = Math.round(totalDurasiDetik / 60);
            let totalTravelTimeFormatted = formatJam(totalTravelTimeMins);

            let totalStopTimeMins = orderedPakets.length * waktuBerhenti;
            let totalAllTime = totalTravelTimeMins + totalStopTimeMins;
            // 1. Hitung total menit keseluruhan
            let totalMenit = totalTravelTimeMins + totalStopTimeMins;
            let totalAllTimeFormatted = formatJam(totalMenit);

            $('#hasilOptimasi').fadeIn(400);
            $('#optCount').text(orderedPakets.length);

            let totalStopTimeFormatted = formatJam(totalStopTimeMins);
            let stopTimeDetail = `<span style="white-space: nowrap;">(${orderedPakets.length} titik \u00d7 ${waktuBerhenti} menit = ${totalStopTimeMins} menit)</span>`;

            $('#optWaktuJalan').html(`${totalTravelTimeFormatted}`);
            $('#optWaktuJalanJam').html(`<span style="white-space: nowrap; ">(${totalTravelTimeMins} <span class="fs-6 fw-normal">menit</span></span>)`);

            // === TAMPILAN: duplikat nilai Waktu Perjalanan untuk baris Rincian Waktu ===
            $('#optWaktuJalan2').html(totalTravelTimeFormatted);
            $('#optWaktuJalanJam2').html(`<span style="white-space: nowrap; ">(${totalTravelTimeMins} <span class="fs-6 fw-normal">menit</span></span>)`);


            $('#optWaktuBerhenti').html(`${totalStopTimeFormatted}`);
            $('#optWaktuBerhentiMnt').html(stopTimeDetail);
            $('#optJarakKesimpulan2').html(formatJarak(totalJarak));
            $('#optWaktuKesimpulanMnt').html(`(<span style="white-space: nowrap; ">${totalAllTime} <span class="fs-6 fw-normal">menit</span></span>)`);
            $('#optWaktuKesimpulan').html(`${totalAllTimeFormatted}`);

            isOptimized = true;

            $('#btnProses').prop('disabled', false).html(`<i class="bi bi-arrow-repeat me-1"></i>Optimasi Ulang`);
            $('#btnSimpan').html('<i class="bi bi-floppy-fill me-2"></i>Simpan Optimasi').removeClass('btn-success').addClass('btn-primary-custom').prop('disabled', false);

            // Scroll ke kartu hasil optimasi di kolom kanan
            $('html, body').animate({ scrollTop: $("#hasilOptimasi").offset().top - 20 }, 600);
        }

        $('#btnSimpan').on('click', function () {

            if (hasilOptimasiGlobal.length === 0) {
                alert("Data optimasi belum ada!");
                return;
            }

            const btn = $(this);
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Menyimpan...');

            // ambil urutan paket hasil optimasi
            const paketIds = hasilOptimasiGlobal.map(x => x.paketId);

            const payload = {
                jadwalId: parseInt(penugasanId),
                paketIds: paketIds
            };

            console.log(payload);

            $.ajax({
                url: API_BASE_URL + '/api/optimization/save-urutan',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),

                success: function (response) {
                    console.log(response);
                    alert("Optimasi berhasil disimpan!");
                    location.href = "/Penugasan/OptimasiPengantaran";
                    btn.html('<i class="bi bi-check-circle-fill me-2"></i>Berhasil Disimpan').removeClass('btn-primary-custom').addClass('btn-success');
                },

                error: function (xhr) {
                    console.log(xhr);
                    alert("Gagal menyimpan urutan!");
                    btn.prop('disabled', false).html('<i class="bi bi-floppy-fill me-2"></i>Simpan Penugasan');
                }
            });

        });


        // === FUNGSI DECODE GOOGLE POLYLINE (KHUSUS MAPBOX [LNG, LAT]) ===
        function decodePolyline(str, precision) {
            var index = 0, lat = 0, lng = 0, coordinates = [], shift = 0, result = 0, byte = null, latitude_change, longitude_change, factor = Math.pow(10, Number.isInteger(precision) ? precision : 5);
            while (index < str.length) {
                byte = null; shift = 0; result = 0;
                do {
                    byte = str.charCodeAt(index++) - 63;
                    result |= (byte & 0x1f) << shift;
                    shift += 5;
                } while (byte >= 0x20);
                latitude_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
                shift = result = 0;
                do {
                    byte = str.charCodeAt(index++) - 63;
                    result |= (byte & 0x1f) << shift;
                    shift += 5;
                } while (byte >= 0x20);
                longitude_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
                lat += latitude_change;
                lng += longitude_change;

                // Mapbox HARUS memakai format array [Longitude, Latitude]
                coordinates.push([lng / factor, lat / factor]);
            }
            return coordinates;
        }


    </script>





