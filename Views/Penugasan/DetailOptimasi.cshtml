    <script>
        function renderHistoryACO(historiesACO,histories2Opt) {
            let currentType = 'aco';

            function renderTable(type) {
                const tbody = $('#tbodyHistoryACO');
                tbody.empty();

                let histories = [];
                /* SELECT TYPE*/
                if (type === 'aco') {
                    histories = historiesACO || [];
                    $('#titleHistoryAlgo').text('Histori Iterasi Ant Colony Optimization (ACO)');
                    $('#subTitleHistoryAlgo').text('Monitoring konvergensi dan perubahan solusi ACO');

                    /* ACTIVE TAB*/
                    $('#btnTabACO').addClass('active-history');
                    $('#btnTab2Opt').removeClass('active-history');

                    /* HIDE SWAP*/
                    $('#s').addClass('d-none');
                }
                else {
                    histories = histories2Opt || [];
                    $('#titleHistoryAlgo').text('Histori Iterasi 2-Opt First Improvement');
                    $('#subTitleHistoryAlgo').text('Monitoring local search');

                    /* ACTIVE TAB*/
                    $('#btnTab2Opt').addClass('active-history');
                    $('#btnTabACO').removeClass('active-history');

                    /* SHOW SWAP*/
                    $('#s').removeClass('d-none');
                }

                /* EMPTY*/
                if (!histories || histories.length === 0) {
                    let textEmpty =
                        type === 'aco'
                            ? 'Tidak ada histori ACO'
                            // : '2-Opt tidak dijalankan pada optimasi ini';
                            : 'Tidak ada perbaikan solusi';

                    tbody.append(`
                        <tr>
                            <td colspan="${type === 'aco' ? 5 : 6}"
                                class="text-center py-5"
                                style="color:#888;">

                                ${textEmpty}

                            </td>
                        </tr>
                    `);
                    return;
                }


                let bestDistance = Math.min(
                    ...histories.map(x => x.bestDistance)
                );
                /* LOOP*/
                let previousDistance = null;
                histories.forEach((item) => {

                    const isBest = item.bestDistance === bestDistance;

                    let statusHtml = isBest
                        ? `
                    <span class="badge"style="background:#DBEAFE;color:#003366;border:1px solid #93C5FD;font-size:11px;font-weight:600;padding:6px 10px;">
                        Jarak Terpendek
                    </span>
                `
                        : `
                    <span class=""
                          style="font-size:11px;font-weight:500;">
                        -
                    </span>
                `;

                    const routeText = item.bestRoute.join(' → ');
                    const durationMinutes = Math.round(item.bestDuration / 60);

                    let swapHtml = '-';

                    if (item.swapValue) {
                        swapHtml = `
                    <span class="badge"
                          style="background:#EFF6FF;color:#185FA5;border:1px solid #BFDBFE;font-size:11px;font-weight:500;padding:6px 10px;">
                        ${item.swapValue}
                    </span>
                `;
                    }

                    tbody.append(`

                        <tr style="${isBest ? 'background:rgba(27,44,89,0.06);' : ''}">

                            <td class="text-center fw-normal">
                                ${item.iteration}
                            </td>

                            <td class="s2 ${type === 'aco' ? 'd-none' : ''}">
                                ${swapHtml}
                            </td>

                            <td>
                                <div class="fw-normal">
                                    ${item.bestDistance.toFixed(3)} km
                                </div>
                            </td>

                            <td>
                                <div class="fw-normal">
                                    ${durationMinutes} menit
                                </div>
                            </td>

                            <td>
                                ${statusHtml}
                            </td>

                            <td style="min-width:300px;">
                                <div style=" font-size:.8rem; white-space:normal; line-height:1.6; ">
                                    ${routeText}
                                </div>
                            </td>
                        </tr>
                    `);
                });

            };

            /* BUTTON TAB*/
            $('#btnTabACO').off('click').on('click', function () {
                renderTable('aco');
            });

            $('#btnTab2Opt').off('click').on('click', function () {
                renderTable('2opt');
            });

            /* DEFAULT*/
            renderTable('aco');
        }


    </script>


