@{
    ViewData["Title"] = "Tambah Penugasan";
}

<main>
    <div class="breadcrumb-bar">
        <a href="/Penugasan/PenugasanPengantaran"><i class="bi bi-truck"></i> Penugasan Pengantaran</a>
        <span class="sep">/</span>
        <span class="current">Tambah Penugasan</span>
    </div>

    <div class="row g-3">
        <div class="col-lg-9 col-12">
            <div class="card bg-white shadow-sm">
                <div class="px-3 pt-3 pb-3 border-bottom">
                    <span class="card-title-section">Informasi Penugasan</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <label class="filter-label" for="tanggalAssign">Tanggal pengantaran</label>
                            <input type="date" id="tanggalAssign" class="form-control form-control-modern shadow-none" disabled>
                        </div>
                        <div class="col-12 col-md-7">
                            <label class="filter-label" for="selectKurir">Oranger Antaran</label>
                            <select id="selectKurir" class="form-select form-control-modern shadow-none">
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-white shadow-sm mt-3">
                <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-3 border-bottom flex-wrap gap-2">
                    <span class="card-title-section">Kiriman Siap Diantar (Manifested)</span>
                    <span class="badge badge-blue" id="jumlahManifested">0 kiriman</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle mb-0" id="tablePaketManifested">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 50px;">No</th>
                                    <th>No. Kiriman</th>
                                    <th>Penerima</th>
                                    <th>Alamat Tujuan</th>
                                    <th>No. Telepon</th>
                                    <th>Layanan</th>
                                    <th class="text-end">Berat</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="p-4 text-center text-muted small d-none" id="emptyManifested">
                    <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
                    Tidak ada kiriman berstatus manifested
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-3">            
            <div class="sticky-top" style="top: 80px; z-index: 10;">
                <div class="card bg-white shadow-sm">
                    <div class="px-3 pt-3 pb-3 border-bottom">
                        <span class="card-title-section">Ringkasan Penugasan</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                            <span class="text-muted small">Jumlah Kiriman</span>
                            <span class="fw-bold" style="color: var(--pos-blue); font-size: 1.1rem;" id="summaryJumlah">0</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                            <span class="text-muted small">Total Berat</span>
                            <span class="fw-semibold text-dark" id="summaryBerat">0 kg</span>
                        </div>
                        <button class="btn btn-pos w-100 justify-content-center" id="btnAssign" disabled>
                            <i class="bi bi-send-check-fill me-1"></i> Buat Penugasan
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(function () {
            const $btnAssign = $('#btnAssign');
            let jumlahManifested = 0;

            function formatTanggal(date) {
                const pad = value => String(value).padStart(2, '0');
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
            }

            function formatBerat(value) {
                return `${(Number.parseFloat(value) || 0).toFixed(2)} kg`;
            }

            function loadKirimanManifested() {
                $.get(API_BASE_URL + '/api/paket')
                    .done(function (response) {
                        const semuaKiriman = response.data ?? response.result ?? response;
                        const kirimanManifested = semuaKiriman.filter(function (kiriman) {
                            return String(kiriman.status ?? '').toLowerCase() === 'manifested';
                        });
                        const totalBerat = kirimanManifested.reduce(function (total, kiriman) {
                            return total + (Number.parseFloat(kiriman.berat_kiriman) || 0);
                        }, 0);

                        jumlahManifested = kirimanManifested.length;
                        $('#jumlahManifested').text(`${jumlahManifested} kiriman`);
                        $('#summaryJumlah').text(jumlahManifested);
                        $('#summaryBerat').text(formatBerat(totalBerat));
                        $btnAssign.prop('disabled', jumlahManifested === 0);

                        const $tbody = $('#tablePaketManifested tbody').empty();
                        kirimanManifested.forEach(function (kiriman, index) {
                            $tbody.append(`
                                <tr>
                                    <td class="text-center text-muted">${index + 1}</td>
                                    <td class="fw-bold">${kiriman.no_kiriman ?? '-'}</td>
                                    <td>${kiriman.recipient_name ?? '-'}</td>
                                    <td class="text-muted small">${kiriman.address ?? '-'}</td>
                                    <td>${kiriman.telepon_penerima ?? '-'}</td>
                                    <td><span class="badge badge-blue">${kiriman.service ?? '-'}</span></td>
                                    <td class="text-end text-nowrap">${formatBerat(kiriman.berat_kiriman)}</td>
                                </tr>
                            `);
                        });
                        $('#tablePaketManifested').toggleClass('d-none', jumlahManifested === 0);
                        $('#emptyManifested').toggleClass('d-none', jumlahManifested !== 0);
                    })
                    .fail(function () {
                        alert('Gagal memuat daftar kiriman manifested.');
                    });
            }

            $.get(API_BASE_URL + '/api/users')
                .done(function (users) {
                    users.forEach(function (user) {
                        $('#selectKurir').append(`<option value="${user.id}">${user.nama}</option>`);
                    });
                })
                .fail(function () {
                    alert('Gagal memuat data Oranger Antaran.');
                });

            $('#tanggalAssign').val(formatTanggal(new Date()));
            loadKirimanManifested();

            $btnAssign.on('click', function () {
                const userId = Number($('#selectKurir').val());
                if (!userId) {
                    alert('Pilih Oranger Antaran terlebih dahulu.');
                    return;
                }
                if (jumlahManifested === 0) {
                    alert('Tidak ada kiriman manifested yang dapat ditugaskan.');
                    return;
                }

                $btnAssign.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Membuat penugasan...');
                $.ajax({
                    url: API_BASE_URL + '/api/manajemen-antaran/assign-to-delivery',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ userId: userId, createdBy: userLogin })
                }).done(function () {
                    window.location.href = '/Penugasan/PenugasanPengantaran';
                }).fail(function (xhr) {
                    alert(xhr.responseJSON?.message || 'Gagal membuat penugasan.');
                    $btnAssign.prop('disabled', false).html('<i class="bi bi-send-check-fill me-1"></i> Buat Penugasan');
                    loadKirimanManifested();
                });
            });
        });
    </script>
}
