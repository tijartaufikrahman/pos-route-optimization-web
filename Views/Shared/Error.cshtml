@model ErrorViewModel
@{
    ViewData["Title"] = "Terjadi Kesalahan";
}

<main>
    <div class="breadcrumb-bar">
        <a href="/"><i class="bi bi-house-door-fill"></i> Dashboard</a>
        <span class="sep">/</span>
        <span class="current">Error</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center p-4 my-4">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: rgba(239, 68, 68, 0.1); color: #EF4444;">
                        <i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-2">Terjadi Kesalahan</h4>
                <p class="text-muted small mb-4">
                    Maaf, terjadi kesalahan saat memproses permintaan Anda. Silakan coba kembali atau hubungi administrator sistem.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="p-3 bg-light rounded text-start mb-4">
                        <small class="text-muted d-block">Request ID:</small>
                        <code class="text-dark fw-semibold">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a href="/" class="btn btn-pos px-4">
                        <i class="bi bi-house-door me-1"></i> Kembali ke Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
